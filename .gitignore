# TakumiDeck – ignorierte Dateien
# Generische Grundausstattung. Projektspezifische Laufzeit-Dateien (DB, Caches, Assets)
# nach Bedarf am Anfang der Datei ergänzen.

# Projekt-Laufzeit (hier erweitern — z.B. *.db, cache/, assets/generated/)

# Electron Forge / Vite Build-Output
.vite/
out/
forge.env.d.ts

# Code-Review-Tooling Reports (Fallow etc.)
.fallow-reports/
.fallow/

# Claude-Code-Runtime-Locks (ScheduleWakeup / Loop) — Projekt-Regeln in
# .claude/rules/ bleiben weiter versioniert.
.claude/*.lock

# Env (lokale Secrets niemals committen)
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Virtuelle Umgebungen
.venv/
venv/
env/

# Node / Frontend (falls zutreffend)
node_modules/
dist/
# build/ enthaelt statische Build-Resourcen (z.B. app-update.yml fuer electron-updater);
# Forge-Output landet in out/ + .vite/, daher nur tatsaechlichen Build-Muell ignorieren.
build/*
!build/app-update.yml
!build/icon.ico

# Package-/Build-Artefakte
*.egg-info/
.tox/
coverage/
.coverage
htmlcov/

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs & Temp
*.log
tmp/
temp/

# Persönliche Claude-Overrides
CLAUDE.local.md
